features = drp_sa[['hba1c_level', 'fasting_blood_sugar']]# 'alcohol_consumption', 'smoking_status'])

X = features
Y = drp_sa['diabetes_risk']
x_train, x_test, y_train, y_test = train_test_split(X, Y, test_size=0.2, random_state=52)

models = []
models.append(('DTC', DecisionTreeClassifier()))
models.append(('Naive Bayes', GaussianNB()))
models.append(('RFC', RandomForestClassifier()))
models.append(('svm', SVC(kernel='linear')))
models.append(('KNN', KNeighborsClassifier(n_neighbors=8)))

for name, model in models:
    model.fit(x_train, y_train)
    ypred = model.predict(x_test)
    print(name,"/n")
    print("Mean_squared_error:", mean_squared_error(y_test,ypred))
    print("Accuracy: ", accuracy_score(y_test,ypred))
